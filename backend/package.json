    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "winston": "^3.18.3",
    "zod": "^4.1.13",
    "uuid": "^13.0.0",
    "@types/node": "^25.0.2",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/config": "^7.0.1",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
