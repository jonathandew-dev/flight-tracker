    "express": "^5.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "@prisma/client": "^7.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typescript": "~5.9.3",
    "@types/node": "^25.0.2",
    "@types/express": "^5.0.5",
    "@types/cors": "^2.8.19",
